APP_NAME="AI Personal Search Engine"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
API_PREFIX="/api/v1"
ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]'
STORAGE_DIR="storage"
INDEX_DIR="database/faiss"
WATCH_DIRECTORIES='[]'
ENABLE_FILE_WATCHER=true
FILE_WATCHER_RECURSIVE=true
FILE_WATCHER_SETTLE_SECONDS=0.5
ENABLE_OCR=true
OCR_LANGUAGE="eng"
# TESSERACT_CMD="/absolute/path/to/tesseract"
OCR_PDF_DPI=200
OCR_MAX_PDF_PAGES=20
CLIP_MODEL_NAME="ViT-B-32"
CLIP_PRETRAINED="laion2b_s34b_b79k"
# CLIP_DEVICE="cpu"
SBERT_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
# SBERT_DEVICE="cpu"
SBERT_NORMALIZE=true
SBERT_BATCH_SIZE=32
SBERT_MAX_CHARS=8000
